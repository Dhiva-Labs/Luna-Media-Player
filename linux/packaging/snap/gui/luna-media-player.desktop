[Desktop Entry]
Name=Luna Media Player
GenericName=Media Player
Comment=Play your music and videos, in an XP-era player
Exec=luna-media-player %F
Icon=${SNAP}/meta/gui/luna-media-player.png
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Video;Player;
Keywords=music;video;player;media;audio;movie;
StartupWMClass=com.dhivalabs.luna_media_player
MimeType=audio/mpeg;audio/flac;audio/ogg;audio/opus;audio/mp4;audio/aac;audio/x-wav;audio/x-ms-wma;audio/x-matroska;video/mp4;video/x-matroska;video/x-msvideo;video/webm;video/quicktime;video/x-ms-wmv;video/mpeg;
